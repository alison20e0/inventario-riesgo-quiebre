# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# .env esta en .gitignore y nunca se versiona.

# --- PostgreSQL ---
DB_NAME=inventario_db
DB_USER=inventario
DB_PASSWORD=cambia_este_password

# --- RabbitMQ ---
RABBITMQ_USER=inventario
RABBITMQ_PASSWORD=cambia_este_password

# --- API ---
SERVER_PORT=8080

# --- Comportamiento ---
# true -> el pronostico falla siempre y se usa el stock minimo (origen FALLBACK_MINIMO)
PRONOSTICO_SIMULAR_FALLO=false
# true -> el consumidor del sistema de compras falla siempre (deja mensaje en la cola de errores)
COMPRAS_SIMULAR_FALLO=false
# true -> carga bodegas, productos y existencias de ejemplo si la base esta vacia
APP_SEED_EJEMPLO=true
